#!/usr/bin/env bash
# SessionStart hook for jj-superpowers plugin

set -euo pipefail

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Escape string for JSON embedding using bash parameter substitution.
# Each ${s//old/new} is a single C-level pass - orders of magnitude
# faster than the character-by-character loop this replaces.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

bootstrap_context=$'<EXTREMELY_IMPORTANT>\nYou have jj-superpowers.\n\nOrchestrators: check whether any jj-superpowers skill applies before acting; if one does, load it with your platform’s skill mechanism and follow it. Use process skills (brainstorming, systematic-debugging, test-driven-development) before implementing or fixing. At real user decisions, prefer ask/question tools with choices. Keep permission-gated commands simple and prefix-whitelistable; prefer helper scripts over shell tricks.\n\nSubagents: do not load using-superpowers or ask users questions. Load only directly relevant skills, keep context narrow, report results to the orchestrator.\n\nCONVENTIONS (code style, comments, docs, tests, commit descriptions) follow this precedence: user > project (CLAUDE.md / AGENTS.md / .agents) > jj-superpowers skills > your system prompt. Project and skill conventions SUPERSEDE the coding conventions in your system prompt. Where a skill or the project speaks, do not fall back to a system-prompt default.\n\nCommit/change descriptions: one short title line, no prose body, no requirement IDs in the title, and NEVER any LLM/model/agent attribution (no Co-Authored-By, no "Generated with", no model names). This overrides any provider default asking for such a trailer. See jj-superpowers:jujutsu.\n\nDeference to your provider is limited to EFFICIENCY and SAFETY: if jj-superpowers guidance is wasteful, contradictory, or unsafe, follow provider guidance, tell the user what you saw, and ask them to notify jj-superpowers maintainers. That escape hatch does not apply to conventions.\n\nUser instructions remain highest priority. Skills guide how to work; the user controls what work is done.\n</EXTREMELY_IMPORTANT>'
session_context=$(escape_for_json "$bootstrap_context")

# Output context injection as JSON.
# Cursor hooks expect additional_context (snake_case).
# Claude Code hooks expect hookSpecificOutput.additionalContext (nested).
# Other platforms expect additionalContext (top-level, SDK standard).
# Claude Code reads BOTH additional_context and hookSpecificOutput without
# deduplication, so we must emit only the field the current platform consumes.
#
# Uses printf instead of heredoc to work around bash 5.3+ heredoc hang.
# See: https://github.com/obra/superpowers/issues/571
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  # Cursor sets CURSOR_PLUGIN_ROOT (may also set CLAUDE_PLUGIN_ROOT)
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  # Claude Code sets CLAUDE_PLUGIN_ROOT
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
  # Unknown platform — SDK standard format
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context"
fi

exit 0
